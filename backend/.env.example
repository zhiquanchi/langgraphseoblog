# ===== LLM 环境变量回退模式（未配置任何 Provider 时使用）=====
# openai / anthropic / ark / dashscope（aliyun、bailian 等价）
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ARK_API_KEY=xxx
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL=doubao-seed-1-6-250615
# DASHSCOPE_API_KEY=sk-xxx
# DASHSCOPE_MODEL=qwen-plus
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== RAG 知识库（不配置则 RAG 功能关闭，生成主流程不受影响）=====
# openai / ark / dashscope（均为 OpenAI 兼容协议）
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# 百炼改用 EMBEDDING_PROVIDER=dashscope + EMBEDDING_MODEL=text-embedding-v4（默认 1024 维）
# 入库会自动按 10 条一批调用，受百炼单次请求上限约束
# 向量库唯一实现为 Qdrant：SQLite 是权威数据，索引只是缓存，集合为空时首次检索自动重建
# 默认走本地嵌入式文件模式（零外部进程），不需要起服务：
# QDRANT_DIR=./data/qdrant
# QDRANT_COLLECTION=seo_knowledge
# 连自建/云上 Qdrant 实例时填 URL（优先级高于 QDRANT_DIR）：
# 本地实例可用仓库根目录的 docker compose up -d qdrant 启动
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
